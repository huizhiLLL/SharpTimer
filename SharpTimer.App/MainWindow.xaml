<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SharpTimer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SharpTimer.App.Controls"
    xmlns:rendering="using:SharpTimer.App.Rendering"
    xmlns:solving="using:SharpTimer.App.Views.Solving"
    xmlns:timing="using:SharpTimer.App.Views.Timing"
    xmlns:views="using:SharpTimer.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SharpTimer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="AppRoot"
        IsTabStop="True"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="0,0,138,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TitleBarPaneToggleButton"
                Width="48"
                Height="48"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="展开或折叠导航"
                Click="TitleBarPaneToggleButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="18" />
            </Button>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                Background="Transparent" />

            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <Image
                    Width="26"
                    Height="26"
                    Source="ms-appx:///Assets/Square44x44Logo.png" />
                <TextBlock
                    x:Name="WindowTitleText"
                    Text="SharpTimer"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="RootGrid"
            Grid.Row="1"
            IsTabStop="True"
            PaneDisplayMode="Left"
            OpenPaneLength="268"
            CompactPaneLength="56"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            SelectionChanged="AppNavigationView_SelectionChanged"
            Background="Transparent">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="TimerNavItem"
                Content="计时"
                Icon="Play"
                Tag="timer" />
            <NavigationViewItem
                x:Name="SolvesNavItem"
                Content="成绩"
                Icon="List"
                Tag="solves" />
        </NavigationView.MenuItems>

        <Grid
            x:Name="PageHost"
            Padding="32">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageHost.Padding" Value="16" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="MediumLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageHost.Padding" Value="24" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageHost.Padding" Value="32" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <timing:TimerView
                x:Name="TimerPage"
                BluetoothButtonClicked="TimerPage_BluetoothButtonClicked"
                BluetoothFlyoutOpened="TimerPage_BluetoothFlyoutOpened"
                BluetoothFlyoutClosed="TimerPage_BluetoothFlyoutClosed"
                BluetoothRetryScanRequested="TimerPage_BluetoothRetryScanRequested"
                BluetoothDeviceClicked="TimerPage_BluetoothDeviceClicked"
                ResetCubeStateRequested="TimerPage_ResetCubeStateRequested"
                ResetCubeOrientationRequested="TimerPage_ResetCubeOrientationRequested"
                DisconnectCubeRequested="TimerPage_DisconnectCubeRequested" />

            <solving:SolvesView
                x:Name="SolvesPage"
                Visibility="Collapsed"
                SessionChanged="SolvesPage_SessionChanged"
                NewSessionRequested="SolvesPage_NewSessionRequested"
                RenameSessionRequested="SolvesPage_RenameSessionRequested"
                ArchiveSessionRequested="SolvesPage_ArchiveSessionRequested"
                SolveClicked="SolvesPage_SolveClicked" />

            <views:SettingsView
                x:Name="SettingsPage"
                Visibility="Collapsed"
                SettingsChanged="SettingsPage_SettingsChanged" />
        </Grid>
        </NavigationView>

    </Grid>
</Window>
