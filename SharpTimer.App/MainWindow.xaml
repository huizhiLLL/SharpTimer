<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SharpTimer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SharpTimer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="AppRoot"
        IsTabStop="True"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="0,0,138,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TitleBarPaneToggleButton"
                Width="48"
                Height="48"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="展开或折叠导航"
                Click="TitleBarPaneToggleButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="18" />
            </Button>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                Background="Transparent" />

            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <Image
                    Width="26"
                    Height="26"
                    Source="ms-appx:///Assets/Square44x44Logo.png" />
                <TextBlock
                    x:Name="WindowTitleText"
                    Text="SharpTimer"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="RootGrid"
            Grid.Row="1"
            IsTabStop="True"
            PaneDisplayMode="Left"
            OpenPaneLength="268"
            CompactPaneLength="56"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            SelectionChanged="AppNavigationView_SelectionChanged"
            Background="Transparent">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="TimerNavItem"
                Content="计时"
                Icon="Play"
                Tag="timer" />
            <NavigationViewItem
                x:Name="SolvesNavItem"
                Content="成绩"
                Icon="List"
                Tag="solves" />
        </NavigationView.MenuItems>

        <Grid Padding="32">
            <Grid
                x:Name="TimerPage"
                RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        x:Name="ScrambleText"
                        MaxWidth="900"
                        Margin="0,24,72,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        FontSize="22"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <Button
                        x:Name="BluetoothButton"
                        Width="44"
                        Height="44"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="22"
                        AutomationProperties.Name="智能魔方蓝牙"
                        Click="BluetoothButton_Click">
                        <FontIcon Glyph="&#xE702;" FontSize="18" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="BluetoothFlyout"
                                Opened="BluetoothFlyout_Opened"
                                Closed="BluetoothFlyout_Closed">
                                <Grid
                                    Width="360"
                                    RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        x:Name="BluetoothFlyoutStatusText"
                                        Text="正在扫描附近魔方..."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <ProgressBar
                                        x:Name="BluetoothScanProgress"
                                        Grid.Row="1"
                                        IsIndeterminate="True" />

                                    <ListView
                                        x:Name="BluetoothDevicesList"
                                        Grid.Row="2"
                                        MaxHeight="260"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="BluetoothDevicesList_ItemClick"
                                        AutomationProperties.Name="智能魔方设备">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="2,8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Text="{Binding Address}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Spacing="2">
                                                        <TextBlock
                                                            Text="{Binding Protocol}"
                                                            HorizontalAlignment="Right"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <Border
                                        x:Name="ConnectedCubePanel"
                                        Grid.Row="3"
                                        Padding="12"
                                        CornerRadius="8"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ConnectedCubeNameText"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Name="ConnectedCubeBatteryText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    x:Name="ResetCubeStateButton"
                                                    Content="重置状态"
                                                    Click="ResetCubeStateButton_Click" />
                                                <Button
                                                    x:Name="DisconnectCubeButton"
                                                    Content="断开连接"
                                                    Click="DisconnectCubeButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,8">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <TextBlock
                            x:Name="TimerText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="112"
                            FontWeight="SemiBold"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform
                                    x:Name="TimerTextScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            x:Name="InspectionText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="18" />
                    </StackPanel>

                    <Canvas
                        x:Name="SmartCubePreviewCanvas"
                        Width="180"
                        Height="180"
                        Margin="0,0,16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TranslateTransform
                                x:Name="SmartCubePreviewOffset"
                                Y="100" />
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>

                <Grid
                    x:Name="StatsPanel"
                    Grid.Row="2"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ao5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Ao5Text" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ao12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Ao12Text" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid
                x:Name="SolvesPage"
                Visibility="Collapsed"
                ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Bottom">
                            <ComboBox
                                x:Name="SessionComboBox"
                                Width="130"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="SessionComboBox_SelectionChanged" />
                            <Button
                                x:Name="RenameSessionButton"
                                Width="36"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="重命名"
                                ToolTipService.ToolTip="重命名"
                                Click="RenameSessionButton_Click">
                                <FontIcon Glyph="&#xE70F;" FontSize="18" />
                            </Button>
                            <Button
                                x:Name="NewSessionButton"
                                Width="36"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="新建"
                                ToolTipService.ToolTip="新建"
                                Click="NewSessionButton_Click">
                                <FontIcon Glyph="&#xE710;" FontSize="18" />
                            </Button>
                            <Button
                                x:Name="ArchiveSessionButton"
                                Width="36"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="删除"
                                ToolTipService.ToolTip="删除"
                                Click="ArchiveSessionButton_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="CountText"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ListView
                        x:Name="SolvesList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="SolvesList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                            <Grid
                                Padding="4,0,4,8"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="序号"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="TimeColumnText"
                                    Grid.Column="1"
                                    Text="时间"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="ao5"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="ao12"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="4,8"
                                    ColumnSpacing="12"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding Number}"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Time}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding TimeForeground}"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding AverageOf5}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding AverageOf5Foreground}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding AverageOf12}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding AverageOf12Foreground}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border
                    Grid.Column="1"
                    Width="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid
                    Grid.Column="2"
                    Padding="0,0,0,0"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ao5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AnalysisAo5Text" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Ao12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AnalysisAo12Text" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock
                                x:Name="AnalysisCountLabelText"
                                Text="次数"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="AnalysisCountText" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" MinHeight="220">
                        <TextBlock
                            Text="趋势图和分布图会放在这里"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid
                x:Name="SettingsPage"
                Visibility="Collapsed"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="SettingsTitleText"
                        Text="设置"
                        FontSize="28"
                        FontWeight="SemiBold" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Padding="18"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="18">
                        <ToggleSwitch
                            x:Name="InspectionSwitch"
                            Header="15 秒观察"
                            Toggled="InspectionSwitch_Toggled" />

                        <ComboBox
                            x:Name="PrecisionComboBox"
                            Header="显示精度"
                            MinWidth="240"
                            SelectionChanged="PrecisionComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="CentisecondsItem" Content="百分秒" />
                            <ComboBoxItem x:Name="MillisecondsItem" Content="毫秒" />
                        </ComboBox>

                        <ComboBox
                            x:Name="ThemeComboBox"
                            Header="主题"
                            MinWidth="240"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="SystemThemeItem" Content="跟随系统" />
                            <ComboBoxItem x:Name="LightThemeItem" Content="亮色" />
                            <ComboBoxItem x:Name="DarkThemeItem" Content="暗色" />
                        </ComboBox>

                        <ComboBox
                            x:Name="BackdropMaterialComboBox"
                            Header="背景材质"
                            MinWidth="240"
                            SelectionChanged="BackdropMaterialComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="MicaMaterialItem" Content="Mica" />
                            <ComboBoxItem x:Name="MicaAltMaterialItem" Content="Mica Alt" />
                            <ComboBoxItem x:Name="AcrylicMaterialItem" Content="Acrylic" />
                        </ComboBox>

                        <ComboBox
                            x:Name="LanguageComboBox"
                            Header="语言"
                            MinWidth="240"
                            SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="ChineseLanguageItem" Content="中文" />
                            <ComboBoxItem x:Name="EnglishLanguageItem" Content="English" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </NavigationView>

        <Grid
            x:Name="SolveDetailsOverlay"
            Grid.RowSpan="2"
            Background="#27000000"
            Visibility="Collapsed"
            Tapped="SolveDetailsOverlay_Tapped">
            <Border
                x:Name="SolveDetailsCard"
                Width="540"
                MaxWidth="540"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Tapped="SolveDetailsCard_Tapped">
                <ScrollViewer MaxHeight="620">
                    <ContentPresenter x:Name="SolveDetailsContent" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
