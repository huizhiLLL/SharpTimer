<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SharpTimer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SharpTimer.App.Controls"
    xmlns:rendering="using:SharpTimer.App.Rendering"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SharpTimer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="AppRoot"
        IsTabStop="True"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="0,0,138,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TitleBarPaneToggleButton"
                Width="48"
                Height="48"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="展开或折叠导航"
                Click="TitleBarPaneToggleButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="18" />
            </Button>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                Background="Transparent" />

            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <Image
                    Width="26"
                    Height="26"
                    Source="ms-appx:///Assets/Square44x44Logo.png" />
                <TextBlock
                    x:Name="WindowTitleText"
                    Text="SharpTimer"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="RootGrid"
            Grid.Row="1"
            IsTabStop="True"
            PaneDisplayMode="Left"
            OpenPaneLength="268"
            CompactPaneLength="56"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            SelectionChanged="AppNavigationView_SelectionChanged"
            Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="TimerImmersionStates">
                    <VisualState x:Name="TimerContextVisible">
                        <VisualState.Setters>
                            <Setter Target="SmartCubePreviewOffset.Y" Value="100" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="TimerImmersive">
                        <VisualState.Setters>
                            <Setter Target="SmartCubePreviewOffset.Y" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="TimerNavItem"
                Content="计时"
                Icon="Play"
                Tag="timer" />
            <NavigationViewItem
                x:Name="SolvesNavItem"
                Content="成绩"
                Icon="List"
                Tag="solves" />
        </NavigationView.MenuItems>

        <Grid
            x:Name="PageHost"
            Padding="32">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageHost.Padding" Value="16" />
                            <Setter Target="TimerText.FontSize" Value="72" />
                            <Setter Target="ScrambleText.Margin" Value="0,16,0,0" />
                            <Setter Target="StatsPanel.RowSpacing" Value="12" />
                            <Setter Target="StatsColumn0.Width" Value="*" />
                            <Setter Target="StatsColumn1.Width" Value="*" />
                            <Setter Target="StatsColumn2.Width" Value="0" />
                            <Setter Target="StatsColumn3.Width" Value="0" />
                            <Setter Target="Ao12StatCard.(Grid.Row)" Value="1" />
                            <Setter Target="Ao12StatCard.(Grid.Column)" Value="0" />
                            <Setter Target="TimerCountStatCard.(Grid.Row)" Value="1" />
                            <Setter Target="TimerCountStatCard.(Grid.Column)" Value="1" />
                            <Setter Target="SolvesPage.RowSpacing" Value="18" />
                            <Setter Target="SolvesListColumn.Width" Value="*" />
                            <Setter Target="SolvesDividerColumn.Width" Value="0" />
                            <Setter Target="SolvesAnalysisColumn.Width" Value="0" />
                            <Setter Target="SolvesDivider.Visibility" Value="Collapsed" />
                            <Setter Target="SolvesAnalysisPanel.(Grid.Row)" Value="1" />
                            <Setter Target="SolvesAnalysisPanel.(Grid.Column)" Value="0" />
                            <Setter Target="SolvesAnalysisPanel.Margin" Value="0,18,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="MediumLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageHost.Padding" Value="24" />
                            <Setter Target="TimerText.FontSize" Value="96" />
                            <Setter Target="ScrambleText.Margin" Value="0,20,0,0" />
                            <Setter Target="StatsPanel.RowSpacing" Value="0" />
                            <Setter Target="StatsColumn0.Width" Value="*" />
                            <Setter Target="StatsColumn1.Width" Value="*" />
                            <Setter Target="StatsColumn2.Width" Value="*" />
                            <Setter Target="StatsColumn3.Width" Value="*" />
                            <Setter Target="Ao12StatCard.(Grid.Row)" Value="0" />
                            <Setter Target="Ao12StatCard.(Grid.Column)" Value="2" />
                            <Setter Target="TimerCountStatCard.(Grid.Row)" Value="0" />
                            <Setter Target="TimerCountStatCard.(Grid.Column)" Value="3" />
                            <Setter Target="SolvesPage.RowSpacing" Value="18" />
                            <Setter Target="SolvesListColumn.Width" Value="*" />
                            <Setter Target="SolvesDividerColumn.Width" Value="0" />
                            <Setter Target="SolvesAnalysisColumn.Width" Value="0" />
                            <Setter Target="SolvesDivider.Visibility" Value="Collapsed" />
                            <Setter Target="SolvesAnalysisPanel.(Grid.Row)" Value="1" />
                            <Setter Target="SolvesAnalysisPanel.(Grid.Column)" Value="0" />
                            <Setter Target="SolvesAnalysisPanel.Margin" Value="0,18,0,0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageHost.Padding" Value="32" />
                            <Setter Target="TimerText.FontSize" Value="112" />
                            <Setter Target="ScrambleText.Margin" Value="0,24,0,0" />
                            <Setter Target="StatsPanel.RowSpacing" Value="0" />
                            <Setter Target="StatsColumn0.Width" Value="*" />
                            <Setter Target="StatsColumn1.Width" Value="*" />
                            <Setter Target="StatsColumn2.Width" Value="*" />
                            <Setter Target="StatsColumn3.Width" Value="*" />
                            <Setter Target="Ao12StatCard.(Grid.Row)" Value="0" />
                            <Setter Target="Ao12StatCard.(Grid.Column)" Value="2" />
                            <Setter Target="TimerCountStatCard.(Grid.Row)" Value="0" />
                            <Setter Target="TimerCountStatCard.(Grid.Column)" Value="3" />
                            <Setter Target="SolvesPage.RowSpacing" Value="0" />
                            <Setter Target="SolvesListColumn.Width" Value="2*" />
                            <Setter Target="SolvesDividerColumn.Width" Value="Auto" />
                            <Setter Target="SolvesAnalysisColumn.Width" Value="3*" />
                            <Setter Target="SolvesDivider.Visibility" Value="Visible" />
                            <Setter Target="SolvesAnalysisPanel.(Grid.Row)" Value="0" />
                            <Setter Target="SolvesAnalysisPanel.(Grid.Column)" Value="2" />
                            <Setter Target="SolvesAnalysisPanel.Margin" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid
                x:Name="TimerPage"
                RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ScrambleText"
                        Grid.Column="1"
                        MaxWidth="900"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        FontSize="22"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <Button
                        x:Name="BluetoothButton"
                        Grid.Column="2"
                        Width="44"
                        Height="44"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        CornerRadius="22"
                        AutomationProperties.Name="智能魔方蓝牙"
                        Click="BluetoothButton_Click">
                        <FontIcon Glyph="&#xE702;" FontSize="18" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="BluetoothFlyout"
                                Opened="BluetoothFlyout_Opened"
                                Closed="BluetoothFlyout_Closed">
                                <Grid
                                    Width="360"
                                    RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="BluetoothFlyoutStatusText"
                                            Text="正在扫描附近魔方..."
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="BluetoothRetryScanButton"
                                            Grid.Column="1"
                                            Visibility="Collapsed"
                                            Click="BluetoothRetryScanButton_Click" />
                                    </Grid>

                                    <ProgressBar
                                        x:Name="BluetoothScanProgress"
                                        Grid.Row="1"
                                        IsIndeterminate="True" />

                                    <ListView
                                        x:Name="BluetoothDevicesList"
                                        Grid.Row="2"
                                        MaxHeight="260"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="BluetoothDevicesList_ItemClick"
                                        AutomationProperties.Name="智能魔方设备">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="2,8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Text="{Binding Address}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Text="{Binding Services}"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            FontSize="12"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Spacing="2">
                                                        <TextBlock
                                                            Text="{Binding Protocol}"
                                                            HorizontalAlignment="Right"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock
                                                            Text="{Binding LastSeen}"
                                                            HorizontalAlignment="Right"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            FontSize="12" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <Border
                                        x:Name="ConnectedCubePanel"
                                        Grid.Row="3"
                                        Padding="12"
                                        CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ConnectedCubeNameText"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Name="ConnectedCubeBatteryText"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    x:Name="ResetCubeStateButton"
                                                    Content="重置状态"
                                                    Click="ResetCubeStateButton_Click" />
                                                <Button
                                                    x:Name="ResetCubeOrientationButton"
                                                    Content="重置姿态"
                                                    Click="ResetCubeOrientationButton_Click" />
                                                <Button
                                                    x:Name="DisconnectCubeButton"
                                                    Content="断开连接"
                                                    Click="DisconnectCubeButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,8">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <TextBlock
                            x:Name="TimerText"
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="112"
                            FontWeight="SemiBold"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform
                                    x:Name="TimerTextScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            x:Name="InspectionText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="18" />
                    </StackPanel>

                    <rendering:SmartCubePreviewControl
                        x:Name="SmartCubePreview"
                        Width="180"
                        Height="180"
                        Margin="0,0,16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed">
                        <rendering:SmartCubePreviewControl.RenderTransform>
                            <TranslateTransform
                                x:Name="SmartCubePreviewOffset"
                                Y="100" />
                        </rendering:SmartCubePreviewControl.RenderTransform>
                    </rendering:SmartCubePreviewControl>
                </Grid>

                <Grid
                    x:Name="StatsPanel"
                    Grid.Row="2"
                    ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StatsColumn0" Width="*" />
                        <ColumnDefinition x:Name="StatsColumn1" Width="*" />
                        <ColumnDefinition x:Name="StatsColumn2" Width="*" />
                        <ColumnDefinition x:Name="StatsColumn3" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="16"
                        CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="BestLabelText"
                                Text="Best"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="BestText"
                                FontSize="24"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="16"
                        CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ao5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Ao5Text" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="Ao12StatCard"
                        Grid.Column="2"
                        Padding="16"
                        CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ao12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Ao12Text" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="TimerCountStatCard"
                        Grid.Column="3"
                        Padding="16"
                        CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="TimerCountLabelText"
                                Text="次数"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="TimerCountText"
                                FontSize="24"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid
                x:Name="SolvesPage"
                Visibility="Collapsed"
                ColumnSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SolvesListColumn" Width="2*" />
                    <ColumnDefinition x:Name="SolvesDividerColumn" Width="Auto" />
                    <ColumnDefinition x:Name="SolvesAnalysisColumn" Width="3*" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Bottom">
                            <ComboBox
                                x:Name="SessionComboBox"
                                Width="130"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="SessionComboBox_SelectionChanged" />
                            <Button
                                x:Name="SessionActionsButton"
                                Width="36"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="Session actions"
                                ToolTipService.ToolTip="Session actions">
                                <FontIcon Glyph="&#xE712;" FontSize="18" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Name="RenameSessionMenuItem"
                                            Click="RenameSessionButton_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="NewSessionMenuItem"
                                            Click="NewSessionButton_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            x:Name="ArchiveSessionMenuItem"
                                            Click="ArchiveSessionButton_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="CountText"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="SolvesList"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="SolvesList_ItemClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Header>
                                <Grid
                                    Padding="4,0,4,8"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="序号"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="TimeColumnText"
                                        Grid.Column="1"
                                        Text="时间"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="ao5"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="ao12"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="4,8"
                                        ColumnSpacing="12"
                                        HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{Binding Number}"
                                            HorizontalAlignment="Stretch"
                                            TextAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Time}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding TimeForeground}"
                                            HorizontalAlignment="Stretch"
                                            TextAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding AverageOf5}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch"
                                            TextAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding AverageOf5Foreground}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding AverageOf12}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch"
                                            TextAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding AverageOf12Foreground}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptySolvesPanel"
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="EmptySolvesTitleText"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="EmptySolvesDescriptionText"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border
                    x:Name="SolvesDivider"
                    Grid.Column="1"
                    Width="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid
                    x:Name="SolvesAnalysisPanel"
                    Grid.Column="2"
                    Padding="0,0,0,0"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="16"
                            CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="AnalysisBestLabelText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="AnalysisBestText"
                                    FontSize="24"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="AnalysisWorstLabelText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="AnalysisWorstText"
                                    FontSize="24"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Padding="16"
                            CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="AnalysisMeanLabelText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="AnalysisMeanText"
                                    FontSize="24"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="16"
                            CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="AnalysisCompletedLabelText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="AnalysisCompletedText"
                                    FontSize="24"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <controls:SolveAnalysisChart
                        x:Name="SolveAnalysisChart"
                        Grid.Row="1" />
                </Grid>
            </Grid>

            <Grid
                x:Name="SettingsPage"
                Visibility="Collapsed"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="SettingsTitleText"
                        Text="设置"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="SettingsDescriptionText"
                        MaxWidth="720"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Spacing="14">
                        <Border
                            Padding="18"
                            CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="SettingsTimingSectionTitleText"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="SettingsTimingSectionDescriptionText"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    MinWidth="260"
                                    Spacing="14">
                                    <ToggleSwitch
                                        x:Name="InspectionSwitch"
                                        Header="15 秒观察"
                                        Toggled="InspectionSwitch_Toggled" />

                                    <ComboBox
                                        x:Name="PrecisionComboBox"
                                        Header="显示精度"
                                        MinWidth="240"
                                        SelectionChanged="PrecisionComboBox_SelectionChanged">
                                        <ComboBoxItem x:Name="CentisecondsItem" Content="百分秒" />
                                        <ComboBoxItem x:Name="MillisecondsItem" Content="毫秒" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="18"
                            CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="SettingsAppearanceSectionTitleText"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="SettingsAppearanceSectionDescriptionText"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    MinWidth="260"
                                    Spacing="14">
                                    <ComboBox
                                        x:Name="ThemeComboBox"
                                        Header="主题"
                                        MinWidth="240"
                                        SelectionChanged="ThemeComboBox_SelectionChanged">
                                        <ComboBoxItem x:Name="SystemThemeItem" Content="跟随系统" />
                                        <ComboBoxItem x:Name="LightThemeItem" Content="亮色" />
                                        <ComboBoxItem x:Name="DarkThemeItem" Content="暗色" />
                                    </ComboBox>

                                    <ComboBox
                                        x:Name="BackdropMaterialComboBox"
                                        Header="背景材质"
                                        MinWidth="240"
                                        SelectionChanged="BackdropMaterialComboBox_SelectionChanged">
                                        <ComboBoxItem x:Name="MicaMaterialItem" Content="Mica" />
                                        <ComboBoxItem x:Name="MicaAltMaterialItem" Content="Mica Alt" />
                                        <ComboBoxItem x:Name="AcrylicMaterialItem" Content="Acrylic" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="18"
                            CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="SettingsLanguageSectionTitleText"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="SettingsLanguageSectionDescriptionText"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="LanguageComboBox"
                                    Grid.Column="1"
                                    Header="语言"
                                    MinWidth="240"
                                    SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem x:Name="ChineseLanguageItem" Content="中文" />
                                    <ComboBoxItem x:Name="EnglishLanguageItem" Content="English" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </NavigationView>

    </Grid>
</Window>
