<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SharpTimer.App.Views.Solving.SolvesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SharpTimer.App.Controls">

    <Grid
        x:Name="Root"
        ColumnSpacing="18">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.RowSpacing" Value="18" />
                        <Setter Target="SolvesListColumn.Width" Value="*" />
                        <Setter Target="SolvesDividerColumn.Width" Value="0" />
                        <Setter Target="SolvesAnalysisColumn.Width" Value="0" />
                        <Setter Target="SolvesDivider.Visibility" Value="Collapsed" />
                        <Setter Target="SolvesAnalysisPanel.(Grid.Row)" Value="1" />
                        <Setter Target="SolvesAnalysisPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SolvesAnalysisPanel.Margin" Value="0,18,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.RowSpacing" Value="18" />
                        <Setter Target="SolvesListColumn.Width" Value="*" />
                        <Setter Target="SolvesDividerColumn.Width" Value="0" />
                        <Setter Target="SolvesAnalysisColumn.Width" Value="0" />
                        <Setter Target="SolvesDivider.Visibility" Value="Collapsed" />
                        <Setter Target="SolvesAnalysisPanel.(Grid.Row)" Value="1" />
                        <Setter Target="SolvesAnalysisPanel.(Grid.Column)" Value="0" />
                        <Setter Target="SolvesAnalysisPanel.Margin" Value="0,18,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.RowSpacing" Value="0" />
                        <Setter Target="SolvesListColumn.Width" Value="2*" />
                        <Setter Target="SolvesDividerColumn.Width" Value="Auto" />
                        <Setter Target="SolvesAnalysisColumn.Width" Value="3*" />
                        <Setter Target="SolvesDivider.Visibility" Value="Visible" />
                        <Setter Target="SolvesAnalysisPanel.(Grid.Row)" Value="0" />
                        <Setter Target="SolvesAnalysisPanel.(Grid.Column)" Value="2" />
                        <Setter Target="SolvesAnalysisPanel.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SolvesListColumn" Width="2*" />
            <ColumnDefinition x:Name="SolvesDividerColumn" Width="Auto" />
            <ColumnDefinition x:Name="SolvesAnalysisColumn" Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom">
                    <ComboBox
                        x:Name="SessionComboBox"
                        Width="130"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="SessionComboBox_SelectionChanged" />
                    <Button
                        x:Name="SessionActionsButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Session actions"
                        ToolTipService.ToolTip="Session actions">
                        <FontIcon Glyph="&#xE712;" FontSize="18" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Name="RenameSessionMenuItem"
                                    Click="RenameSessionMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="NewSessionMenuItem"
                                    Click="NewSessionMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Name="ArchiveSessionMenuItem"
                                    Click="ArchiveSessionMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="CountText"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <ListView
                    x:Name="SolvesList"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="SolvesList_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid
                            Padding="4,0,4,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="序号"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="TimeColumnText"
                                Grid.Column="1"
                                Text="时间"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="2"
                                Text="ao5"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="3"
                                Text="ao12"
                                HorizontalAlignment="Stretch"
                                TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="4,8"
                                ColumnSpacing="12"
                                HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding Number}"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Time}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding TimeForeground}"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding AverageOf5}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding AverageOf5Foreground}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding AverageOf12}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Stretch"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding AverageOf12Foreground}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptySolvesPanel"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="EmptySolvesTitleText"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="EmptySolvesDescriptionText"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border
            x:Name="SolvesDivider"
            Grid.Column="1"
            Width="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid
            x:Name="SolvesAnalysisPanel"
            Grid.Column="2"
            Padding="0,0,0,0"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="AnalysisMeanLabelText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AnalysisMeanText"
                            FontSize="24"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="16"
                    CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="AnalysisBestLabelText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AnalysisBestText"
                            FontSize="24"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Padding="16"
                    CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="AnalysisBestAverageOf5LabelText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AnalysisBestAverageOf5Text"
                            FontSize="24"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="16"
                    CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="AnalysisBestAverageOf12LabelText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AnalysisBestAverageOf12Text"
                            FontSize="24"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="2"
                    Padding="16"
                    CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="AnalysisMovesAverageLabelText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AnalysisMovesAverageText"
                            FontSize="24"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Padding="16"
                    CornerRadius="{ThemeResource SharpTimerCardCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="AnalysisTpsAverageLabelText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="AnalysisTpsAverageText"
                            FontSize="24"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <controls:SolveAnalysisChart
                x:Name="SolveAnalysisChart"
                Grid.Row="1" />
        </Grid>
    </Grid>
</UserControl>
