<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SharpTimer.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="SettingsTitleText"
            Text="设置"
            FontSize="28"
            FontWeight="SemiBold" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="720"
                HorizontalAlignment="Left"
                Spacing="4">
                <ToggleSwitch
                    x:Name="InspectionSwitch"
                    Header="15 秒观察"
                    Toggled="SettingControl_Changed" />

                <ComboBox
                    x:Name="PrecisionComboBox"
                    Header="显示精度"
                    MinWidth="240"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="SettingControl_Changed">
                    <ComboBoxItem x:Name="CentisecondsItem" Content="百分秒" />
                    <ComboBoxItem x:Name="MillisecondsItem" Content="毫秒" />
                </ComboBox>

                <ComboBox
                    x:Name="ThemeComboBox"
                    Header="主题"
                    MinWidth="240"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="SettingControl_Changed">
                    <ComboBoxItem x:Name="SystemThemeItem" Content="跟随系统" />
                    <ComboBoxItem x:Name="LightThemeItem" Content="亮色" />
                    <ComboBoxItem x:Name="DarkThemeItem" Content="暗色" />
                </ComboBox>

                <ComboBox
                    x:Name="BackdropMaterialComboBox"
                    Header="背景材质"
                    MinWidth="240"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="SettingControl_Changed">
                    <ComboBoxItem x:Name="MicaMaterialItem" Content="Mica" />
                    <ComboBoxItem x:Name="MicaAltMaterialItem" Content="Mica Alt" />
                    <ComboBoxItem x:Name="AcrylicMaterialItem" Content="Acrylic" />
                </ComboBox>

                <ComboBox
                    x:Name="LanguageComboBox"
                    Header="语言"
                    MinWidth="240"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="SettingControl_Changed">
                    <ComboBoxItem x:Name="ChineseLanguageItem" Content="中文" />
                    <ComboBoxItem x:Name="EnglishLanguageItem" Content="English" />
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
