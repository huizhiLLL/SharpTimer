<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SharpTimer.App.Rendering.SmartCubePreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    IsHitTestVisible="True"
    AutomationProperties.Name="智能魔方预览">

    <Canvas
        x:Name="PreviewCanvas"
        Background="Transparent"
        PointerPressed="PreviewCanvas_PointerPressed"
        PointerMoved="PreviewCanvas_PointerMoved"
        PointerReleased="PreviewCanvas_PointerReleased"
        PointerCanceled="PreviewCanvas_PointerCanceled"
        PointerCaptureLost="PreviewCanvas_PointerCanceled"
        Tapped="PreviewCanvas_Tapped" />
</UserControl>
